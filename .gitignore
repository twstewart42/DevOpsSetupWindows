.env
.env.*
!.env.example
mise.local.toml
.mise.local.toml
*.pem
*.key
kubeconfig*

# --- Logs, backups, temp ---
*.log
*.bak
*.tmp
*.swp
*.swo
*~

# --- OS / editor cruft (.vscode/extensions.json is tracked) ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- Agent scratch space ---
.superpowers/
